---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Layout from '@layouts/Layout.astro';
import { formatDate } from '@utils/date';
import PostHeadings from '@layouts/components/table-of-contents/PostHeadings.astro';
import RelatedPosts from '@layouts/components/blog/RelatedPosts.astro';
import SocialShare from '@layouts/components/blog/SocialShare.astro';
import SeriesNav from '@layouts/components/widgets/SeriesNav.astro';
import ReadingProgress from '@layouts/components/blog/ReadingProgress.astro';
import Breadcrumb from '@layouts/components/common/Breadcrumb.astro';
import { company } from '@config/company';

const { post, headings } = Astro.props;
const { title, description, image, date, categories, authors, tags } = post.data;

// Get the canonical URL for this post
// Make sure we have a valid site URL to avoid the TypeError: Invalid URL error
const canonicalURL = Astro.site 
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.pathname;

// No reading time calculation needed

// Generate breadcrumbs for structured data
const breadcrumbs = [
  { name: 'Świat Wrażeń', url: '/' },
  { name: 'Blog', url: '/blog/' }
];

if (categories && categories.length > 0) {
  breadcrumbs.push({ name: categories[0], url: `/categories/${categories[0].toLowerCase()}/` });
}

breadcrumbs.push({ name: title, url: canonicalURL });

const pageTitle = `${title} | ${company.name}`;
const helpfulLinks = [
  { label: 'Cennik', href: '/cennik/' },
  { label: 'Oferta', href: '/oferta/' },
  { label: 'FAQ', href: '/faq/' },
  { label: 'Skonfiguruj przyjęcie', href: '/#konfigurator' }
];

const suggestedCategories = [
  { label: 'Urodziny', slug: 'urodziny' },
  { label: 'Porady dla rodziców', slug: 'porady-dla-rodzicow' },
  { label: 'Miejsca na przyjęcia', slug: 'miejsca-na-przyjecia' }
];
---

<Layout
  title={pageTitle}
  description={description}
  image={image?.src || undefined}
  article={true}
  canonical={canonicalURL}
  publishDate={date}
  author={authors && authors.length > 0 ? { name: authors[0] } : undefined}
  tags={tags}
  categories={categories}
  breadcrumbs={breadcrumbs}>
  <!-- Reading Progress Bar -->
<ReadingProgress />

<section class="w-full py-section" style="transition: opacity 0.3s ease;">
  <Breadcrumb items={breadcrumbs} className="mb-6" />
  <div class="flex flex-col gap-10 lg:flex-row">
    <article class="flex-1">
      <header class="mb-8 rounded-lg border border-sw-border bg-sw-card p-6 shadow-card">
        <div class="flex flex-wrap items-center gap-4 text-sw-muted">
          <div class="flex items-center gap-2">
            <Icon name="mdi:calendar" class="h-5 w-5" />
            <time datetime={date?.toISOString()}>{date ? formatDate(date) : ''}</time>
          </div>
          {categories && categories.length > 0 && (
            <div class="flex flex-wrap items-center gap-2">
              <Icon name="mdi:folder" class="h-5 w-5" />
              {categories.map((category: string) => (
                <a
                  href={`/categories/${category.toLowerCase()}/`}
                  class="font-medium text-sw-primary hover:text-sw-primaryDark"
                >
                  {category}
                </a>
              ))}
            </div>
          )}
          {authors && authors.length > 0 && (
            <div class="flex flex-wrap items-center gap-2">
              <Icon name="mdi:account" class="h-5 w-5" />
              {authors.map((author: string) => (
                <a href={`/authors/${author.toLowerCase()}/`} class="font-medium text-sw-primary hover:text-sw-primaryDark">
                  {author}
                </a>
              ))}
            </div>
          )}
        </div>
        <h1 class="mt-6 text-4xl font-black text-sw-text">{title}</h1>
        {description && <p class="mt-4 text-lg text-sw-muted">{description}</p>}
        {image && (
          <div class="mt-8 overflow-hidden rounded-lg">
            <Image src={image} alt={title} class="h-full w-full object-cover" width={1280} height={720} />
          </div>
        )}
        {tags && tags.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {tags.map((tag: string) => (
              <a
                href={`/tags/${tag.toLowerCase()}/`}
                class="rounded-lg bg-sw-bg px-3 py-1 text-sm font-medium text-sw-primary"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}
      </header>

      {post.data.series && Array.isArray(post.data.series) && post.data.series.length === 2 && (
        <SeriesNav currentSlug={post.slug} seriesName={post.data.series[0]} seriesPosition={post.data.series[1]} />
      )}

      <div class="mb-8 rounded-lg border border-sw-border bg-sw-card p-4 shadow-card">
        <PostHeadings headings={headings} />
      </div>

      <div class="prose prose-lg prose-headings:font-bold prose-a:text-sw-primary prose-img:rounded-lg text-sw-text dark:prose-invert">
        <slot />
      </div>

      <SocialShare title={title} description={description} url={canonicalURL} />
      <RelatedPosts currentPost={post} />
    </article>

    <aside class="lg:w-80">
      <div class="space-y-6 lg:sticky lg:top-24">
        <div class="rounded-lg border border-sw-border bg-sw-card p-6 shadow-card">
          <h3 class="text-xl font-medium text-sw-text">Przydatne linki</h3>
          <ul class="mt-4 space-y-3 text-sw-muted">
            {helpfulLinks.map((link) => (
              <li>
                <a href={link.href} class="font-medium text-sw-primary hover:text-sw-primaryDark">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-lg border border-sw-border bg-sw-card p-6 shadow-card">
          <h3 class="text-xl font-medium text-sw-text">Popularne kategorie</h3>
          <ul class="mt-4 space-y-2 text-sw-muted">
            {suggestedCategories.map((category) => (
              <li>
                <a href={`/categories/${category.slug}/`} class="hover:text-sw-primary">
                  {category.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-lg border border-sw-border bg-sw-card p-6 shadow-card">
          <h3 class="text-lg font-medium text-sw-text">Planowanie przyjęcia?</h3>
          <p class="mt-2 text-sm text-sw-muted">
            Sprawdź cennik lub wypełnij konfigurator – przygotujemy ofertę dopasowaną do liczby dzieci i lokalizacji.
          </p>
          <a
            href="/#konfigurator"
            class="mt-4 inline-flex rounded-lg bg-sw-primary px-4 py-3 text-sm font-medium text-white shadow-card hover:bg-sw-primaryDark"
          >
            Skonfiguruj przyjęcie
          </a>
        </div>
      </div>
    </aside>
  </div>
</section>
</Layout>
