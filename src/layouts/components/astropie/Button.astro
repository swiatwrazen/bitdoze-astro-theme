---
const { color = "primary", url = "", newtab = false, As = "a", class: className = "", ...props } = Astro.props;

const variants = {
  primary:
    "inline-flex items-center justify-center rounded-lg bg-sw-primary px-5 py-3 text-base font-medium text-white transition-colors hover:bg-sw-primaryDark",
  secondary:
    "inline-flex items-center justify-center rounded-lg border border-sw-border bg-white px-5 py-3 text-base font-medium text-sw-text transition-colors hover:border-sw-primary hover:text-sw-primary",
};

const classes = [variants[color] ?? variants.primary, className].filter(Boolean).join(" ");
---

<As
	class={classes}
	href={url}
	target={newtab ? "_blank" : "_self"}
	rel={newtab ? "noopener noreferrer" : ""}
	{...props}
>
	<slot />
</As>
