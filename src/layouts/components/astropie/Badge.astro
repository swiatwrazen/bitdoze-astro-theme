---
const { color = "primary", title = "" }: BadgeProps = Astro.props;

interface BadgeProps {
	color?: "primary" | "secondary" | "white" | "green" | "red";
	title?: string;
}

const colors = {
	primary: "bg-sw-primary/10 text-sw-text ring-1 ring-sw-primary/20",
	secondary: "bg-sw-bg text-sw-text ring-1 ring-sw-border",
	green: "bg-sw-primary/10 text-sw-text ring-1 ring-sw-primary/20",
	red: "bg-sw-primary/10 text-sw-text ring-1 ring-sw-primary/20",
	white: "bg-white",
};
---

<span class={`inline-flex not-prose items-center mb-4 rounded-lg px-3 py-1 text-base font-medium ${colors[color]}`}
	>{title}</span
>
