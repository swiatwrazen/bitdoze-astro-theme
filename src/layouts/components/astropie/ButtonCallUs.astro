---
import phoneIcon from "@assets/icons/phone.svg";
import { phone } from "@config/company";
---

<a
  href={phone.href}
  class="not-prose flex items-center gap-x-3 transition duration-300 hover:-translate-y-1"
>
  <img src={phoneIcon.src} alt="Telefon" class="size-12 rounded-lg bg-sw-primary/10 p-2.5" loading="lazy" />
  <div>
    <p class="text-sm text-sw-muted">Zadzwoń do nas</p>
    <span class="text-base font-medium text-sw-primary">{phone.label}</span>
  </div>
</a>
