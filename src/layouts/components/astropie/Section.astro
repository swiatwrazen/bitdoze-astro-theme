---
const { id, class: className, contain = true } = Astro.props;

const sectionClasses = ["py-section"];
if (Array.isArray(className)) {
  sectionClasses.push(...className);
} else if (typeof className === "string") {
  sectionClasses.push(className);
}
---

<section id={id} class={sectionClasses.join(" ")}>
  {contain ? (
    <div class="mx-auto w-full max-w-6xl px-4">
      <slot />
    </div>
  ) : (
    <slot />
  )}
</section>
