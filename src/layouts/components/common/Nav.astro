---
import menu from "@config/menu.json";
import { company } from "@config/company";

type MenuChild = {
  name: string;
  url: string;
  normalizedUrl: string;
};

type MenuItem = {
  name: string;
  url: string;
  hasChildren?: boolean;
  normalizedUrl: string;
  children: MenuChild[];
  id: string;
};

const normalize = (value?: string | null) => {
  if (!value || value === "/") return "/";
  return value.endsWith("/") ? value.slice(0, -1) : value;
};

const currentPath = normalize(Astro.url.pathname ?? "/");
const mainMenu: MenuItem[] = (menu.main ?? []).map((item, index) => {
  const normalizedUrl = normalize(item.url);
  const children = (item.children ?? []).map((child) => ({
    ...child,
    normalizedUrl: normalize(child.url),
  }));

  return {
    ...item,
    normalizedUrl,
    children,
    id: `submenu-${index}`,
  };
});

const isItemActive = (item: MenuItem) => {
  if (item.normalizedUrl === currentPath) return true;
  return item.children.some((child) => child.normalizedUrl === currentPath);
};

const childLinkClasses = (child: MenuChild) => {
  const base = "block rounded-lg px-4 py-2 text-sm transition";
  if (child.normalizedUrl === currentPath) {
    return `${base} bg-sw-primary/5 font-semibold text-sw-primary`;
  }
  return `${base} text-sw-muted hover:bg-sw-primary/5 hover:text-sw-primary`;
};

const parentLinkClasses = () => {
  const base = "inline-flex items-center gap-1 rounded-lg px-3 py-4 text-sm font-medium text-white transition whitespace-nowrap";
  return `${base} hover:text-white/80`;
};
---

<header class="sticky top-0 z-40 m-1 bg-white/5 backdrop-blur lg:bg-none lg:backdrop-blur-none">
  <div class="mx-auto flex w-full rounded items-center justify-between gap-4 m-1 p-3 bg-sw-primary">
    <a href="/" class="inline-flex items-center" aria-label={company.name}>
      <img src="/favicon.svg" alt={company.name} class="h-8 w-auto lg:h-8 mx-3" />
      <span class="text-xl font-extrabold uppercase text-white">{company.name}</span>
    </a>

    <nav class="hidden items-center gap-6 text-sm font-medium text-white lg:flex" aria-label="Główna nawigacja">
      {mainMenu.map((item) =>
        item.hasChildren && item.children.length ? (
          <div class="relative group">
            <a
              href={item.url}
              class={`${parentLinkClasses()} pr-1`}
              aria-haspopup="true"
              aria-expanded="false"
            >
              {item.name}
              <svg class="size-4 text-white transition group-hover:-rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 10.94l3.71-3.71a.75.75 0 1 1 1.06 1.06l-4.24 4.25a.75.75 0 0 1-1.06 0L5.21 8.29a.75.75 0 0 1 .02-1.08Z"
                  clip-rule="evenodd"
                ></path>
              </svg>
            </a>
            <div class="invisible absolute left-0 top-11/12 z-40 w-56 -translate-y-2 rounded-xl border border-sw-border bg-white/95 p-3 opacity-0 shadow-card transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
              {item.children.map((child) => (
                <a href={child.url} class={childLinkClasses(child)}>
                  {child.name}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.url} class={parentLinkClasses()}>
            {item.name}
          </a>
        )
      )}
      <a
        href="/kontakt"
        class="hidden rounded-lg bg-sw-contrast px-5 py-3 text-sm font-medium text-white shadow-card transition-colors hover:bg-sw-contrastHover lg:inline-flex"
      >
        Zarezerwuj termin
      </a>
    </nav>

    <button
      type="button"
      class="inline-flex items-center rounded-lg p-2 text-white transition hover:bg-white/10 lg:hidden"
      aria-label="Otwórz menu"
      data-nav-toggle
    >
      <svg class="size-6" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
        <path
          d="M128 102.4c0-14.138 11.462-25.6 25.6-25.6h332.8c14.138 0 25.6 11.462 25.6 25.6s-11.462 25.6-25.6 25.6H153.6c-14.138 0-25.6-11.463-25.6-25.6Zm358.4 128H25.6C11.462 230.4 0 241.863 0 256c0 14.138 11.462 25.6 25.6 25.6h460.8c14.138 0 25.6-11.462 25.6-25.6 0-14.137-11.462-25.6-25.6-25.6Zm0 153.6H256c-14.137 0-25.6 11.462-25.6 25.6 0 14.137 11.463 25.6 25.6 25.6h230.4c14.138 0 25.6-11.463 25.6-25.6 0-14.138-11.462-25.6-25.6-25.6Z"
        />
      </svg>
    </button>
  </div>

  <div
    data-nav-panel
    class="lg:hidden hidden fixed inset-x-0 top-0 z-50 w-full h-screen overflow-y-auto bg-white/95 px-5 py-6 backdrop-blur"
    aria-hidden="true"
  >
    <div class="flex items-center justify-between">
      <p class="text-xl font-black text-sw-text">{company.name}</p>
      <button
        type="button"
        class="inline-flex items-center rounded-lg border border-sw-border p-2 text-sw-text transition hover:bg-sw-bg"
        aria-label="Zamknij menu"
        data-nav-close
      >
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M6 18 18 6"></path>
        </svg>
      </button>
    </div>
    <nav class="mt-8 flex flex-col gap-4 text-lg font-medium text-sw-text" aria-label="Menu mobilne">
      {mainMenu.map((item) =>
        item.hasChildren && item.children.length ? (
          <div class="rounded-xl border border-sw-border/70 p-3">
            <a
              href={item.url}
              class={`block text-base font-semibold transition hover:text-sw-primary ${isItemActive(item) ? "text-sw-primary" : "text-sw-text"}`}
            >
              {item.name}
            </a>
            <div class="mt-3 flex flex-col gap-1 border-t border-sw-border/60 pt-3">
              {item.children.map((child) => (
                <a href={child.url} class={childLinkClasses(child)}>
                  {child.name}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.url}
            class={`rounded-lg px-4 py-3 transition hover:bg-sw-primary/5 ${isItemActive(item) ? "text-sw-primary" : "text-sw-text"}`}
          >
            {item.name}
          </a>
        )
      )}
    </nav>
    <a
      href="/kontakt"
      class="mt-8 block rounded-lg bg-sw-primary px-5 py-3 text-center text-base font-medium text-white shadow-card transition hover:bg-sw-primaryDark"
    >
      Zarezerwuj termin
    </a>
  </div>
</header>

<script>
  const initMobileNav = () => {
    const panel = document.querySelector("[data-nav-panel]");
    if (!panel || panel.dataset.ready === "true") return;
    panel.dataset.ready = "true";

    const toggleButton = document.querySelector("[data-nav-toggle]");
    const closeButtons = panel.querySelectorAll("[data-nav-close]");
    const links = panel.querySelectorAll("a");

    const setOpen = (open) => {
      panel.classList.toggle("hidden", !open);
      panel.setAttribute("aria-hidden", String(!open));
      document.body.classList.toggle("overflow-hidden", open);
    };

    toggleButton?.addEventListener("click", () => {
      const isHidden = panel.classList.contains("hidden");
      setOpen(isHidden);
    });

    closeButtons.forEach((button) => button.addEventListener("click", () => setOpen(false)));
    links.forEach((link) => link.addEventListener("click", () => setOpen(false)));

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024) {
        setOpen(false);
      }
    });
  };

  const run = () => initMobileNav();

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", run, { once: true });
  } else {
    run();
  }

  document.addEventListener("astro:page-load", run);
</script>
