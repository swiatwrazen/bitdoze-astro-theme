---
import type { PricePackage } from "@data/pricing";

interface Props {
  pkg: PricePackage;
  featured?: boolean;
}

const { pkg, featured = false } = Astro.props;
---

<article
  class={`relative flex h-full flex-col rounded-lg border border-sw-border bg-sw-card p-6 shadow-card transition hover:-translate-y-1 ${
    featured ? "border-sw-primary" : ""
  }`}
>
  {featured && (
    <span class="absolute right-6 top-6 rounded-lg bg-sw-primary/10 px-3 py-1 text-xs font-medium uppercase tracking-wide text-sw-primary">
      Najczęściej wybierany
    </span>
  )}
  <header class="space-y-3">
    <p class="text-xs font-medium uppercase tracking-[0.2em] text-sw-primary">Pakiet</p>
    <h3 class="text-2xl font-bold text-sw-text">{pkg.name}</h3>
    {pkg.description && <p class="text-sm text-sw-muted">{pkg.description}</p>}
  </header>

  <dl class="mt-6 grid gap-4 text-sm font-medium text-sw-muted sm:grid-cols-2">
    <div>
      <dt class="text-xs uppercase tracking-wide text-sw-primary">Czas trwania</dt>
      <dd class="text-base font-medium text-sw-text">{pkg.duration}</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wide text-sw-primary">Liczba dzieci</dt>
      <dd class="text-base font-medium text-sw-text">{pkg.maxChildren}</dd>
    </div>
  </dl>

  <p class="mt-6 text-3xl font-black text-sw-primary">{pkg.price}</p>

  <ul class="mt-4 space-y-2 text-sm text-sw-text/80">
    {pkg.features.map((feature) => (
      <li class="flex items-start gap-2">
        <span aria-hidden="true" class="mt-1 size-1.5 rounded-lg bg-sw-primary"></span>
        <span>{feature}</span>
      </li>
    ))}
  </ul>

  {pkg.bestFor && (
    <p class="mt-4 rounded-lg bg-sw-bg px-4 py-3 text-sm font-medium text-sw-text">
      Najlepszy dla: {pkg.bestFor}
    </p>
  )}
</article>
