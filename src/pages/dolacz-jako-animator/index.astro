---
import Layout from "@layouts/Layout.astro";
import Section from "@components/astropie/Section.astro";
import Badge from "@components/astropie/Badge.astro";
import { email } from "@config/company";

const requirements = [
  "Pełnoletność i status studenta lub doświadczenie w pracy z dziećmi",
  "Słowna i energiczna komunikacja po polsku (mile widziany angielski)",
  "Dyspozycyjność w weekendy i popołudnia",
  "Doświadczenie w prowadzeniu zabaw lub warsztatów kreatywnych",
];

const onboarding = ["Szkolenia z naszych scenariuszy i zasad bezpieczeństwa", "Stałe wsparcie koordynatora wydarzeń", "Umowa zlecenie lub B2B – zależnie od preferencji", "Dostęp do zaplecza rekwizytów i kostiumów"];

const workDays = ["Piątek", "Sobota", "Niedziela", "Dni powszednie popołudnia"];
---

<Layout title="Dołącz do zespołu animatorów Świat Wrażeń" description="Szukamy animatorów i animatorek do prowadzenia urodzin, warsztatów i wydarzeń rodzinnych w Warszawie. Wypełnij formularz i rozpocznij współpracę.">
  <Section>
    <div class="mx-auto max-w-4xl space-y-6">
      <Badge title="Rekrutacja" color="primary" />
      <h1 class="text-4xl font-black text-sw-text">Dołącz do zespołu animatorów Świat Wrażeń</h1>
      <p class="text-lg text-sw-muted">
        Jeśli kochasz pracę z dziećmi, masz energię i chcesz prowadzić kreatywne zabawy – zostaw nam swoje zgłoszenie. Oferujemy szkolenia,
        wsparcie koordynatora i elastyczne grafiki.
      </p>
    </div>
  </Section>

  <Section>
    <div class="grid gap-8 lg:grid-cols-2">
      <article class="rounded-lg border border-sw-border bg-sw-card p-6 shadow-card">
        <h2 class="text-2xl font-medium text-sw-text">Czego oczekujemy?</h2>
        <ul class="mt-4 space-y-3 text-sw-muted">
          {requirements.map((item) => (
            <li>✔ {item}</li>
          ))}
        </ul>
      </article>
      <article class="rounded-lg border border-sw-border bg-sw-card p-6 shadow-card">
        <h2 class="text-2xl font-medium text-sw-text">Jak wygląda onboarding?</h2>
        <ul class="mt-4 space-y-3 text-sw-muted">
          {onboarding.map((item) => (
            <li>✔ {item}</li>
          ))}
        </ul>
      </article>
    </div>
  </Section>

  <Section>
    <div class="mx-auto max-w-3xl rounded-lg border border-sw-border bg-sw-card p-8 shadow-card">
      <h2 class="text-3xl font-black text-sw-text">Formularz zgłoszeniowy</h2>
      <p class="mt-2 text-sw-muted">
        Formularz trafia do naszego koordynatora. Odezwiemy się na podany adres e-mail. Możesz też napisać bezpośrednio na{" "}
        <a href={email.href} class="font-medium text-sw-primary">{email.label}</a>.
      </p>
      <form class="mt-6 space-y-4" action={email.href} method="post" enctype="text/plain">
        <label class="block text-sm text-sw-muted">
          Imię i nazwisko
          <input type="text" name="Imię i nazwisko" required class="w-full rounded-lg border border-sw-border px-3 py-3 text-sm text-sw-text focus:border-sw-primary focus:outline-none focus:ring-1 focus:ring-sw-primary" />
        </label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block text-sm text-sw-muted">
            E-mail
            <input type="email" name="Email" required class="w-full rounded-lg border border-sw-border px-3 py-3 text-sm text-sw-text focus:border-sw-primary focus:outline-none focus:ring-1 focus:ring-sw-primary" />
          </label>
          <label class="block text-sm text-sw-muted">
            Telefon
            <input type="tel" name="Telefon" required class="w-full rounded-lg border border-sw-border px-3 py-3 text-sm text-sw-text focus:border-sw-primary focus:outline-none focus:ring-1 focus:ring-sw-primary" />
          </label>
        </div>
        <label class="block text-sm text-sw-muted">
          Doświadczenie
          <textarea name="Doświadczenie" rows="4" required class="w-full rounded-lg border border-sw-border px-3 py-3 text-sm text-sw-text focus:border-sw-primary focus:outline-none focus:ring-1 focus:ring-sw-primary"></textarea>
        </label>
        <fieldset class="rounded-lg border border-sw-border p-4">
          <legend class="px-2 text-sm font-medium text-sw-text">Preferowane dni pracy</legend>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            {workDays.map((day) => (
              <label class="inline-flex items-center gap-2 text-sw-muted">
                <input type="checkbox" name="Preferowane dni" value={day} class="rounded border-sw-border text-sw-primary focus:ring-sw-primary" />
                {day}
              </label>
            ))}
          </div>
        </fieldset>
        <button type="submit" class="w-full inline-flex items-center justify-center rounded-lg bg-sw-primary px-4 py-3.5 text-sm font-medium text-white transition-colors hover:bg-sw-primaryDark">
          Wyślij zgłoszenie
        </button>
      </form>
    </div>
  </Section>
</Layout>
