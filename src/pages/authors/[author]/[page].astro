---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import PostCard from '@components/blog/PostCard.astro';
import Pagination from '@components/common/Pagination.astro';
import { getPagination } from '@utils/pagination';
import { siteConfig } from '@config/site';

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection('posts', ({ data }) => {
    return !data.draft;
  });
  
  // Get all unique authors
  const authors = [...new Set(posts.flatMap(post => post.data.authors || []))];
  
  // Create paths for each author and its pages
  return authors.flatMap(author => {
    // Filter posts by author
    const authorPosts = posts.filter(post => 
      post.data.authors && post.data.authors.includes(author)
    ).sort((a, b) => {
      return new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime();
    });
    
    // Generate pages for this author
    const totalPages = Math.ceil(authorPosts.length / siteConfig.postsPerPage);
    
    const authorSlug = author.toLowerCase();
    return Array.from({ length: totalPages }).map((_, i) => {
      const pageNumber = i + 1;
      if (pageNumber === 1) {
        return {
          params: { 
            author: authorSlug,
            page: 'page-1'
          },
          props: {
            author,
            redirectTo: `/authors/${authorSlug}/`
          }
        };
      }
      
      return {
        params: { 
          author: authorSlug,
          page: `page-${pageNumber}`
        },
        props: { 
          author,
          posts: authorPosts,
          pageNumber,
          count: authorPosts.length
        }
      };
    });
  });
}

const { author, posts, pageNumber, count, redirectTo } = Astro.props;
if (redirectTo) {
  return Astro.redirect(redirectTo, 301);
}
const currentPage = typeof pageNumber === 'number' ? pageNumber : 1;
const basePath = `/authors/${author.toLowerCase()}/`;
const isFirstPage = currentPage <= 1;
const pageSuffix = isFirstPage ? '' : ` – strona ${currentPage}`;

// Get pagination data
const { startIndex, endIndex, prevUrl, nextUrl, totalPages } = getPagination({ 
  page: currentPage, 
  totalPosts: count, 
  basePath 
});

// Get posts for the current page
const paginatedPosts = posts.slice(startIndex, endIndex);

const noindex = false;

// Format the author name for display
const formattedAuthor = author.split(' ').map(word => 
  word.charAt(0).toUpperCase() + word.slice(1).toLowerCase()
).join(' ');
const pageHeading = isFirstPage ? formattedAuthor : `${formattedAuthor}${pageSuffix}`;
const baseTitle = `Posty autora ${formattedAuthor} - ${siteConfig.name}`;
const baseDescription = `Browse posts written by ${formattedAuthor}`;
const pageTitle = `${baseTitle}${pageSuffix}`;
const pageDescription = `${baseDescription}${pageSuffix}`;
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  noindex={noindex}
>
  <div class="w-full py-8">
    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">
        {pageHeading}
      </h1>
    </header>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {paginatedPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
    
    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
      basePath={basePath}
    />
  </div>
</Layout>
