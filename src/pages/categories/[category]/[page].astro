---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import PostCard from '@components/blog/PostCard.astro';
import Pagination from '@components/common/Pagination.astro';
import { getPagination } from '@utils/pagination';
import { siteConfig } from '@config/site';

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection('posts', ({ data }) => {
    return !data.draft;
  });
  
  // Get all unique categories
  const categories = [...new Set(posts.flatMap(post => post.data.categories || []))];
  
  // Create paths for each category and its pages
  return categories.flatMap(category => {
    // Filter posts by category
    const categoryPosts = posts.filter(post => 
      post.data.categories && post.data.categories.includes(category)
    ).sort((a, b) => {
      return new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime();
    });
    
    // Generate pages for this category
    const totalPages = Math.ceil(categoryPosts.length / siteConfig.postsPerPage);
    
    const categorySlug = category.toLowerCase();
    return Array.from({ length: totalPages }).map((_, i) => {
      const pageNumber = i + 1;
      if (pageNumber === 1) {
        return {
          params: { 
            category: categorySlug,
            page: 'page-1'
          },
          props: {
            category,
            redirectTo: `/categories/${categorySlug}/`
          }
        };
      }
      
      return {
        params: { 
          category: categorySlug,
          page: `page-${pageNumber}`
        },
        props: { 
          category,
          posts: categoryPosts,
          pageNumber,
          count: categoryPosts.length
        }
      };
    });
  });
}

const { category, posts, pageNumber, count, redirectTo } = Astro.props;
if (redirectTo) {
  return Astro.redirect(redirectTo, 301);
}
const currentPage = typeof pageNumber === 'number' ? pageNumber : 1;
const basePath = `/categories/${category.toLowerCase()}/`;
const isFirstPage = currentPage <= 1;
const pageSuffix = isFirstPage ? '' : ` – strona ${currentPage}`;

// Get pagination data
const { startIndex, endIndex, prevUrl, nextUrl, totalPages } = getPagination({ 
  page: currentPage, 
  totalPosts: count, 
  basePath 
});

// Get posts for the current page
const paginatedPosts = posts.slice(startIndex, endIndex);

const noindex = false;

// Format the category name for display
const formattedCategory = category.charAt(0).toUpperCase() + category.slice(1);
const pageHeading = isFirstPage ? formattedCategory : `${formattedCategory}${pageSuffix}`;
const baseTitle = `${formattedCategory} - ${siteConfig.name}`;
const baseDescription = `Browse posts in the ${formattedCategory} category`;
const pageTitle = `${baseTitle}${pageSuffix}`;
const pageDescription = `${baseDescription}${pageSuffix}`;
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  noindex={noindex}
>
  <div class="w-full py-8">
    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">
        Kategorie: {pageHeading}
      </h1>
    </header>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {paginatedPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
    
    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
      basePath={basePath}
    />
  </div>
</Layout>
