---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import PostCard from '@components/blog/PostCard.astro';
import Pagination from '@components/common/Pagination.astro';
import { getPagination } from '@utils/pagination';
import { siteConfig } from '@config/site';

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection('posts', ({ data }) => {
    return !data.draft;
  });
  
  // Get all unique tags
  const tags = [...new Set(posts.flatMap(post => post.data.tags || []))];
  
  // Create paths for each tag and its pages
  return tags.flatMap(tag => {
    // Filter posts by tag
    const tagPosts = posts.filter(post => 
      post.data.tags && post.data.tags.includes(tag)
    ).sort((a, b) => {
      return new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime();
    });
    
    // Generate pages for this tag
    const totalPages = Math.ceil(tagPosts.length / siteConfig.postsPerPage);
    
    const tagSlug = tag.toLowerCase();
    return Array.from({ length: totalPages }).map((_, i) => {
      const pageNumber = i + 1;
      if (pageNumber === 1) {
        return {
          params: { 
            tag: tagSlug,
            page: 'page-1'
          },
          props: {
            tag,
            redirectTo: `/tags/${tagSlug}/`
          }
        };
      }
      
      return {
        params: { 
          tag: tagSlug,
          page: `page-${pageNumber}`
        },
        props: { 
          tag,
          posts: tagPosts,
          pageNumber,
          count: tagPosts.length
        }
      };
    });
  });
}

const { tag, posts, pageNumber, count, redirectTo } = Astro.props;
if (redirectTo) {
  return Astro.redirect(redirectTo, 301);
}
const currentPage = typeof pageNumber === 'number' ? pageNumber : 1;
const basePath = `/tags/${tag.toLowerCase()}/`;
const isFirstPage = currentPage <= 1;
const pageSuffix = isFirstPage ? '' : ` – strona ${currentPage}`;

// Get pagination data
const { startIndex, endIndex, prevUrl, nextUrl, totalPages } = getPagination({ 
  page: currentPage, 
  totalPosts: count, 
  basePath 
});

// Get posts for the current page
const paginatedPosts = posts.slice(startIndex, endIndex);

const noindex = false;

// Format the tag name for display
const formattedTag = tag.charAt(0).toUpperCase() + tag.slice(1);
const pageHeading = isFirstPage ? `#${formattedTag}` : `#${formattedTag}${pageSuffix}`;
const baseTitle = `Posty z tagiem ${formattedTag} - ${siteConfig.name}`;
const baseDescription = `Browse posts tagged with ${formattedTag}`;
const pageTitle = `${baseTitle}${pageSuffix}`;
const pageDescription = `${baseDescription}${pageSuffix}`;
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  noindex={noindex}
>
  <div class="w-full py-8">
    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">
        {pageHeading}
      </h1>
    </header>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {paginatedPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
    
    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
      basePath={basePath}
    />
  </div>
</Layout>
