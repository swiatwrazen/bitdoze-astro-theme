---
import Layout from "@layouts/Layout.astro";
import Section from "@components/astropie/Section.astro";
import Badge from "@components/astropie/Badge.astro";
import Button from "@components/astropie/Button.astro";
import ButtonCallUs from "@components/astropie/ButtonCallUs.astro";
import LandingHero from "@components/landing/Hero.astro";
import TrustSection from "@components/landing/TrustSection.astro";
import PricePackageCard from "@components/landing/PricePackageCard.astro";
import { pricePackages } from "@data/pricing";

const benefits = [
  {
    title: "Indywidualny scenariusz",
    description:
      "Proponujemy zabawy i atrakcje dopasowane do wieku, liczby uczestników oraz motywu przewodniego wydarzenia.",
  },
  {
    title: "Animatorzy z doświadczeniem",
    description:
      "Zespół pedagogów i artystów, którzy angażują dzieci i dbają o atmosferę nawet podczas dużych eventów.",
  },
  {
    title: "Atrakcje tematyczne",
    description:
      "Papierowe show, fluo party, warsztaty kreatywne, superbohaterowie i księżniczki – łączymy je w gotowe pakiety.",
  },
  {
    title: "Kompletna obsługa",
    description:
      "Dekoracje, candy bar, nagłośnienie oraz koordynacja dnia wydarzenia. Rodzice mogą cieszyć się chwilą.",
  },
];

const processSteps = [
  {
    title: "Konsultacja i wywiad",
    description: "Krótka rozmowa telefoniczna lub formularz online, w którym opisujesz potrzeby i marzenia dziecka.",
    meta: "15 minut",
  },
  {
    title: "Propozycja programu",
    description: "W ciągu 24 godzin przesyłamy dopasowane pakiety, kosztorys i rekomendację atrakcji dodatkowych.",
    meta: "24 godziny",
  },
  {
    title: "Koordynacja i logistyka",
    description: "Rezerwujemy animatorów, dekoracje, sprzęt oraz potwierdzamy harmonogram z miejscem wydarzenia.",
    meta: "Do 3 dni przed",
  },
  {
    title: "Prowadzenie animacji",
    description: "Animator przyjeżdża minimum 30 minut wcześniej, przygotowuje stanowisko i prowadzi zabawy od A do Z.",
    meta: "Dzień wydarzenia",
  },
];

const commitments = [
  "Obsługujemy urodziny, chrzciny, komunie, wesela i rodzinne przyjęcia.",
  "Realizujemy animacje na piknikach firmowych, integracjach i wydarzeniach szkolnych.",
  "Działamy w Warszawie i do 30 km wokół stolicy – dojazd w cenie.",
  "Zapewniamy polisę OC oraz umowę potwierdzającą zakres usługi.",
];

const offerSections = [
  {
    title: "Animacje dla dzieci",
    description:
      "Urodziny w domu, ogrodzie lub sali zabaw – dynamiczne gry ruchowe, konkursy i opieka nad grupą.",
    href: "/animacja/animator-dla-dzieci-warszawa",
  },
  {
    title: "Animacje tematyczne",
    description:
      "Superbohaterowie, księżniczki, Harry Potter, Minecraft i wiele innych motywów dopasowanych do solenizanta.",
    href: "/animacja/animacje-tematyczne",
  },
  {
    title: "Atrakcje specjalne",
    description:
      "Papierowe show, fluo party, warsztaty kreatywne oraz spotkania sezonowe z Mikołajem lub elfami.",
    href: "/atrakcje-dla-dzieci/papierowe-show-silver-party",
  },
  {
    title: "Dekoracje i słodki stół",
    description:
      "Balony z helem, torty, candy bary oraz aranżacje przestrzeni, które podkreślają motyw przewodni przyjęcia.",
    href: "/dekoracje-i-słodycze/balonow-z-helem-warszawa",
  },
];

const recognitions = [
  {
    title: "Najlepsi Animatorzy 2025",
    body: "Po raz drugi otrzymaliśmy wyróżnienie Oferteo. Ponad 60 opinii i średnia 4.98/5 potwierdzają jakość naszych animacji.",
    cta: {
      label: "Zobacz opinie",
      href: "https://swiatwrazen.oferteo.pl/",
    },
  },
  {
    title: "Partner Karty Warszawiaka",
    body: "Posiadacze karty zyskują 10% zniżki na zamówienia indywidualne. Dołącz do rodziców, którzy nam zaufali.",
    cta: {
      label: "Sprawdź szczegóły",
      href: "https://www.swiatwrazen.pl/karta-warszawiaka",
    },
  },
];

const popularPackages = pricePackages.slice(0, 3);
---

<Layout title="Świat Wrażeń" description="Animacje, urodziny i atrakcje dla dzieci w Warszawie." wideContent={true}>
  <LandingHero />
  <TrustSection />

  <Section>
    <div class="mx-auto max-w-3xl text-center">
      <Badge title="Dlaczego rodzice nas wybierają" color="primary" />
      <h2 class="mt-4 text-3xl font-black text-sw-text">Usługa dopasowana do potrzeb Twojej rodziny</h2>
      <p class="mt-4 text-lg text-sw-muted">
        Analizujemy wiek dzieci, liczbę gości i budżet, aby przestawić konkretny, przejrzysty plan przyjęcia.
      </p>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {benefits.map((item) => (
        <article class="rounded-lg border border-sw-border bg-sw-card p-6 shadow-card">
          <h3 class="text-xl font-medium text-sw-text">{item.title}</h3>
          <p class="mt-3 text-sw-muted">{item.description}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section>
    <div class="mx-auto max-w-3xl text-center">
      <Badge title="Popularne pakiety" color="secondary" />
      <h2 class="mt-4 text-3xl font-black text-sw-text">Transparentne pakiety animacji</h2>
      <p class="mt-4 text-lg text-sw-muted">
        Każdy pakiet obejmuje dojazd, zestaw muzyczny i scenariusz dopasowany do wieku dzieci. Rozszerzysz go o dodatki z sekcji
        „Dodatkowe usługi”.
      </p>
    </div>
    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {popularPackages.map((pkg) => (
        <PricePackageCard pkg={pkg} featured={pkg.id === "birthday-premium"} />
      ))}
    </div>
    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <Button url="/cennik" color="primary">Zobacz pełny cennik</Button>
      <a href="/#konfigurator" class="font-medium text-sw-primary hover:text-sw-text">Skonfiguruj przyjęcie</a>
    </div>
  </Section>

  <Section>
    <div class="grid gap-10 lg:grid-cols-[3fr,2fr]">
      <div>
        <Badge title="Jak wygląda współpraca" color="secondary" />
        <h2 class="mt-4 text-3xl font-black text-sw-text">Prosty proces bez zaskoczeń</h2>
        <p class="mt-4 text-sw-muted">
          Łączymy konsultacje online z autorskimi scenariuszami, aby już na etapie wyceny pokazać przebieg animacji i koszty dodatkowych atrakcji.
        </p>
        <ol class="mt-8 space-y-6">
          {processSteps.map((step, index) => (
            <li class="flex gap-4 rounded-lg bg-white p-5 shadow-card ring-1 ring-sw-border/50">
              <div class="flex size-10 items-center justify-center rounded-lg bg-sw-primary/10 text-base font-bold text-sw-primary">
                {(index + 1).toString().padStart(2, "0")}
              </div>
              <div class="flex-1">
                <p class="text-sm font-medium uppercase tracking-wide text-sw-primary">{step.meta}</p>
                <h3 class="text-xl font-medium text-sw-text">{step.title}</h3>
                <p class="mt-2 text-sw-muted">{step.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <aside class="rounded-lg bg-white p-6 shadow-card ring-1 ring-sw-border/50">
        <h3 class="text-2xl font-medium text-sw-text">Co otrzymujesz w pakiecie</h3>
        <ul class="mt-4 space-y-3 text-sw-muted">
          {commitments.map((item) => (
            <li>✔ {item}</li>
          ))}
        </ul>
      </aside>
    </div>
  </Section>

  <Section class:list={["bg-white"]}>
    <div class="mx-auto max-w-4xl text-center">
      <Badge title="Oferta" color="primary" />
      <h2 class="mt-4 text-3xl font-black text-sw-text">Pakiety animacji i atrakcji</h2>
      <p class="mt-4 text-lg text-sw-muted">
        Wybierz gotowy zestaw lub połącz elementy według własnego pomysłu. Każdą ofertę możemy rozszerzyć o dekoracje i obsługę słodkiego stołu.
      </p>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {offerSections.map((item) => (
        <article class="flex h-full flex-col justify-between rounded-lg border border-sw-border bg-sw-card p-6 shadow-card">
          <div>
            <h3 class="text-xl font-medium text-sw-primary">{item.title}</h3>
            <p class="mt-3 text-sw-muted">{item.description}</p>
          </div>
          <div class="mt-6">
            <Button url={item.href} color="primary">Dowiedz się więcej</Button>
          </div>
        </article>
      ))}
    </div>
  </Section>

  <Section>
    <div class="rounded-lg border border-sw-border bg-sw-card p-8 shadow-card">
      <div class="grid gap-8 lg:grid-cols-2">
        {recognitions.map((item) => (
          <article class="flex flex-col gap-4">
            <h3 class="text-2xl font-medium text-sw-text">{item.title}</h3>
            <p class="text-sw-muted">{item.body}</p>
            <a
              href={item.cta.href}
              class="inline-flex items-center gap-2 font-medium text-sw-primary hover:text-sw-text"
              target="_blank"
              rel="noopener"
            >
              {item.cta.label}
              <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M5.22 5.22a.75.75 0 0 1 1.06 0L14 12.94V7a.75.75 0 0 1 1.5 0v7a.75.75 0 0 1-.75.75h-7a.75.75 0 0 1 0-1.5h5.94L6.28 6.28a.75.75 0 0 1 0-1.06Z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </Section>

  <Section class:list={["bg-sw-primary text-white"]} contain={false}>
    <div class="mx-auto w-full max-w-6xl px-4 py-section text-center">
      <h2 class="text-3xl font-black text-white">Porozmawiajmy o Twoim wydarzeniu</h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Zadzwoń lub napisz, aby ustalić termin animacji i otrzymać wstępny kosztorys. Możemy zacząć od konfiguratora lub szybkiej rozmowy telefonicznej.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button url="/kontakt" color="secondary">Wypełnij formularz</Button>
        <Button url="/cennik" color="primary">Sprawdź cennik</Button>
        <ButtonCallUs />
      </div>
    </div>
  </Section>
</Layout>
